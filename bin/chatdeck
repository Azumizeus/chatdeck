#!/usr/bin/env bash
# chatdeck — lanceur maison, sans dépendance supplémentaire.
#
# Ce que fait `npm run dev` : rien de plus que démarrer Vite. Ce que fait ce
# script, en plus, et qui évite les incidents quotidiens :
#
#   • détecte un port déjà occupé (5199) et en prend un libre au lieu d'échouer
#   • n'ouvre le navigateur qu'une fois le serveur réellement prêt à répondre
#   • refuse de démarrer si des dépendances manquent, au lieu d'afficher une
#     erreur Vite illisible trois secondes plus tard
#   • laisse le serveur Attached au terminal (Ctrl-C arrête tout proprement)
#
# Usage
#   chatdeck              démarre + ouvre le navigateur
#   chatdeck --port 5200  force le port
#   chatdeck --no-open    ne pas ouvrir le navigateur
#   chatdeck --build      construit dist/ et sert en mode aperçu (aucun watcher)
#   chatdeck --check      svelte-check seul, puis sort
#   chatdeck --stop       arrête un serveur chatdeck laissé en arrière-plan

set -euo pipefail

PORT=""
OPEN=1
MODE="dev"

for arg in "$@"; do
  case "$arg" in
    --port) PORT="${2:-}"; shift ;;
    --port=*) PORT="${arg#*=}"; shift ;;
    --no-open) OPEN=0; shift ;;
    --build) MODE="build"; shift ;;
    --check) MODE="check"; shift ;;
    --stop) MODE="stop"; shift ;;
    -h|--help)
      sed -n '2,20p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
      exit 0 ;;
    *)
      echo "option inconnue : $arg (voir --help)" >&2
      exit 2 ;;
  esac
done

# ── localisation du projet ───────────────────────────────────────────────────
resolve_root() {
  local d
  d="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  while [ "$d" != "/" ]; do
    if [ -f "$d/package.json" ] && grep -q '"name"[[:space:]]*:[[:space:]]*"chatdeck"' "$d/package.json" 2>/dev/null; then
      printf '%s\n' "$d"; return 0
    fi
    d="$(dirname "$d")"
  done
  return 1
}

ROOT="${CHATDECK_HOME:-$(resolve_root || true)}"
[ -n "$ROOT" ] || { echo "✗ projet chatdeck introuvable. Lance depuis le projet, ou : CHATDECK_HOME=/chemin chatdeck" >&2; exit 1; }
cd "$ROOT"

# ── prérequis ───────────────────────────────────────────────────────────────
command -v node >/dev/null 2>&1 || { echo "✗ node absent" >&2; exit 1; }

[ -d node_modules ] || {
  echo "✗ dépendances absentes. Lance : cd $ROOT && npm install" >&2
  exit 1
}

# ── arrêt d'une instance laissée en arrière-plan ─────────────────────────────
PIDFILE="$ROOT/.chatdeck.pid"

stop_it() {
  if [ -f "$PIDFILE" ]; then
    local pid; pid="$(cat "$PIDFILE" 2>/dev/null || true)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
      echo "✓ arrêté (pid $pid)"
    else
      echo "· aucun processus vivant"
    fi
    rm -f "$PIDFILE"
  else
    # Repli : un vite qui traîne et appartient BIEN à ce projet. On filtre sur
    # le chemin des node_modules du projet — un `pgrep -f vite` global tuerait
    # les serveurs des autres projets de la machine.
    local pids
    pids="$(pgrep -f "$ROOT/node_modules/.bin/vite" 2>/dev/null || true)"
    if [ -n "$pids" ]; then
      # shellcheck disable=SC2086
      kill $pids 2>/dev/null || true
      echo "✓ arrêté (pid $pids) — limité à $ROOT"
    else
      echo "· rien à arrêter"
    fi
  fi
}

if [ "$MODE" = "stop" ]; then stop_it; exit 0; fi

if [ "$MODE" = "check" ]; then
  exec npm run --silent check
fi

# ── port ────────────────────────────────────────────────────────────────────
port_busy() { lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1; }

if [ -z "$PORT" ]; then
  PORT=5199
  while port_busy "$PORT" && [ "$PORT" -lt 5299 ]; do
    PORT=$((PORT + 1))
  done
  if port_busy "$PORT"; then
    echo "✗ aucun port libre entre 5199 et 5299" >&2
    exit 1
  fi
elif port_busy "$PORT"; then
  echo "✗ port $PORT déjà occupé" >&2
  exit 1
fi

URL="http://localhost:$PORT"

echo "▸ chatdeck — $ROOT"
echo "  mode    : $MODE"
echo "  url     : $URL"

# ── ouverture du navigateur, une fois le serveur prêt ───────────────────────
if [ "$OPEN" = 1 ]; then
  (
    for _ in $(seq 1 100); do
      sleep 0.3
      if curl -fsS -o /dev/null "$URL" 2>/dev/null; then
        open "$URL" && exit 0
      fi
    done
  ) &
fi

# ── lancement ───────────────────────────────────────────────────────────────
if [ "$MODE" = "build" ]; then
  npm run build
  echo "✓ dist/ construit. Sert en aperçu :"
  echo "  npx vite preview --port $PORT"
  exit 0
fi

# Vite en avant-plan : Ctrl-C arrête le serveur. On note le PID pour --stop.
npx vite --port "$PORT" --strictPort &
VITE_PID=$!
echo "$VITE_PID" > "$PIDFILE"
trap 'rm -f "$PIDFILE"' EXIT INT TERM
wait "$VITE_PID"
